&НаКлиенте
Асинх Процедура ВыбратьИЗагрузить(Команда)
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Выберите книгу с исходными данными";
	ПараметрыДиалога.Фильтр = "Книга Excel (*.xlsx)|*.xlsx";
	ПараметрыДиалога.МножественныйВыбор = Ложь;

	Попытка
		ФайлЗагрузки = Ждать ПоместитьФайлНаСерверАсинх(,,, ПараметрыДиалога, УникальныйИдентификатор);
		Если ФайлЗагрузки = Неопределено Или ФайлЗагрузки.ПомещениеФайлаОтменено Тогда
			Возврат;
		КонецЕсли;
		РезультатЗагрузки = ЗагрузитьНаСервере(ФайлЗагрузки.Адрес);
	Исключение
		РезультатЗагрузки = "Ошибка загрузки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьНаСервере(АдресФайла)
	Возврат ЗагрузкаДанных.Загрузить(АдресФайла);
КонецФункции
