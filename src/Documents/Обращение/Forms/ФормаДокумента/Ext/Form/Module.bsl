&НаКлиенте
Процедура ДатаИлиПриоритетПриИзменении(Элемент)
	ОбновитьСрокНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСрокНаСервере()
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	СохраненноеСостояние = Неопределено;
	Если Не ДокументОбъект.Ссылка.Пустая() Тогда
		СохраненноеСостояние = ДокументОбъект.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	ДокументОбъект.ПересчитатьСрок(СохраненноеСостояние);
	Объект.СрокВыполнения = ДокументОбъект.СрокВыполнения;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьПохожиеОбращения();
КонецПроцедуры

&НаКлиенте
Процедура ПомещениеИлиКатегорияПриИзменении(Элемент)
	ОбновитьПохожиеОбращения();
КонецПроцедуры

&НаСервере
Процедура ОбновитьПохожиеОбращения()
	ТекстПохожихОбращений = "";
	ПервоеПохожееОбращение = Документы.Обращение.ПустаяСсылка();
	Если ЗначениеЗаполнено(Объект.Помещение) И ЗначениеЗаполнено(Объект.Категория) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 3
			| Обращения.Ссылка КАК Ссылка,
			| Обращения.Номер КАК Номер,
			| Обращения.Описание КАК Описание
			|ИЗ Документ.Обращение КАК Обращения
			|ГДЕ Обращения.Помещение = &Помещение
			| И Обращения.Категория = &Категория
			| И Обращения.Ссылка <> &Ссылка
			| И НЕ Обращения.ПометкаУдаления
			| И Обращения.Статус В (&Новая, &ВРаботе)
			|УПОРЯДОЧИТЬ ПО Обращения.Дата УБЫВ, Обращения.Номер УБЫВ";
		Запрос.УстановитьПараметр("Помещение", Объект.Помещение);
		Запрос.УстановитьПараметр("Категория", Объект.Категория);
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		Запрос.УстановитьПараметр("Новая", Перечисления.СтатусыОбращений.Новая);
		Запрос.УстановитьПараметр("ВРаботе", Перечисления.СтатусыОбращений.ВРаботе);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(ПервоеПохожееОбращение) Тогда
				ПервоеПохожееОбращение = Выборка.Ссылка;
			Иначе
				ТекстПохожихОбращений = ТекстПохожихОбращений + Символы.ПС;
			КонецЕсли;
			ОписаниеСтрокой = СтрЗаменить(СтрЗаменить(Выборка.Описание, Символы.ПС, " "), Символы.ВК, " ");
			ТекстПохожихОбращений = ТекстПохожихОбращений + "№ " + Выборка.Номер + " — " + Лев(ОписаниеСтрокой, 150);
		КонецЦикла;
	КонецЕсли;
	ЕстьПохожие = ЗначениеЗаполнено(ПервоеПохожееОбращение);
	Элементы.ПохожиеОбращения.Видимость = ЕстьПохожие;
	Элементы.ОткрытьПохожееОбращение.Видимость = ЕстьПохожие;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПохожееОбращениеНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(ПервоеПохожееОбращение) Тогда
		ОткрытьФорму("Документ.Обращение.Форма.ФормаДокумента", Новый Структура("Ключ", ПервоеПохожееОбращение));
	КонецЕсли;
КонецПроцедуры
