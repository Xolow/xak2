&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	ОбновитьОтборНаСервере();
	Элементы.Список.Обновить();

КонецПроцедуры

&НаСервере
Процедура ОбновитьОтборНаСервере()
	Отбор = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	Отбор.Элементы.Очистить();
	ДобавитьОтбор(Отбор, "Помещение.Корпус", ОтборКорпус);
	ДобавитьОтбор(Отбор, "Статус", ОтборСтатус);
	ДобавитьОтбор(Отбор, "Исполнитель", ОтборИсполнитель);
КонецПроцедуры

&НаСервере
Процедура ДобавитьОтбор(Отбор, ИмяПоля, ЗначениеОтбора)
	Если Не ЗначениеЗаполнено(ЗначениеОтбора) Тогда
		Возврат;
	КонецЕсли;
	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ЗначениеОтбора;
	ЭлементОтбора.Использование = Истина;
КонецПроцедуры
