Перем ПредыдущееСостояние;

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыОбращений.Новая;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	ПредыдущееСостояние = Неопределено;
	Импорт = Ложь;
	ЗначениеИмпорта = Неопределено;
	Если ДополнительныеСвойства.Свойство("ЗагрузкаИсходныхДанных", ЗначениеИмпорта) Тогда
		Импорт = ЗначениеИмпорта = Истина;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Дата) Тогда
		СообщитьОбОшибке("Укажите дату обращения.", "Дата", Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Помещение) Тогда
		СообщитьОбОшибке("Укажите помещение.", "Помещение", Отказ);
	КонецЕсли;
	Если ТолькоПробелы(Описание) Тогда
		СообщитьОбОшибке("Укажите описание обращения.", "Описание", Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Категория) Тогда
		СообщитьОбОшибке("Укажите категорию неисправности.", "Категория", Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Приоритет) Тогда
		СообщитьОбОшибке("Укажите приоритет обращения.", "Приоритет", Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Статус) Тогда
		СообщитьОбОшибке("Укажите статус обращения.", "Статус", Отказ);
	КонецЕсли;

	Новая = Перечисления.СтатусыОбращений.Новая;
	ВРаботе = Перечисления.СтатусыОбращений.ВРаботе;
	Выполнена = Перечисления.СтатусыОбращений.Выполнена;
	Отменена = Перечисления.СтатусыОбращений.Отменена;

	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Если Статус = ВРаботе Тогда
			СообщитьОбОшибке("Нельзя перевести заявку в работу без исполнителя", "Исполнитель", Отказ);
		ИначеЕсли Статус = Выполнена Тогда
			СообщитьОбОшибке("Нельзя завершить заявку без исполнителя", "Исполнитель", Отказ);
		КонецЕсли;
	КонецЕсли;
	Если Статус = Выполнена И ТолькоПробелы(Результат) Тогда
		СообщитьОбОшибке("Нельзя завершить заявку без описания результата", "Результат", Отказ);
	КонецЕсли;

	Предыдущий = Неопределено;
	Если Не Ссылка.Пустая() Тогда
		Предыдущий = Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Если Не Импорт Тогда
		Если Предыдущий = Неопределено Тогда
			Если ЗначениеЗаполнено(Статус) И Статус <> Новая Тогда
				СообщитьОбОшибке("Новое обращение должно иметь статус «Новая».", "Статус", Отказ);
			КонецЕсли;
		ИначеЕсли Статус <> Предыдущий.Статус Тогда
			ДопустимыйПереход = (Предыдущий.Статус = Новая И (Статус = ВРаботе Или Статус = Отменена))
				Или (Предыдущий.Статус = ВРаботе И (Статус = Выполнена Или Статус = Отменена));
			Если Не ДопустимыйПереход Тогда
				СообщитьОбОшибке("Недопустимый переход статуса обращения.", "Статус", Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Статус = Выполнена Тогда
		Если Не Импорт Тогда
			Если Предыдущий <> Неопределено И Предыдущий.Статус = Выполнена Тогда
				ДатаВыполнения = Предыдущий.ДатаВыполнения;
			Иначе
				ДатаВыполнения = ТекущаяДатаСеанса();
			КонецЕсли;
		ИначеЕсли Не ЗначениеЗаполнено(ДатаВыполнения) Тогда
			ДатаВыполнения = ТекущаяДатаСеанса();
		КонецЕсли;
	Иначе
		ДатаВыполнения = Дата(1, 1, 1);
	КонецЕсли;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Не ПересчитатьСрок(Предыдущий) Тогда
		СообщитьОбОшибке("Для выбранного приоритета не задан нормативный срок.", "Приоритет", Отказ);
	КонецЕсли;
	ПредыдущееСостояние = Предыдущий;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если Не Отказ Тогда
		ИсторияОбращенийСервер.ЗафиксироватьИзменение(ЭтотОбъект, ПредыдущееСостояние);
	КонецЕсли;
	ПредыдущееСостояние = Неопределено;

КонецПроцедуры

Функция ПересчитатьСрок(СохраненноеСостояние = Неопределено) Экспорт

	Если СохраненноеСостояние <> Неопределено
			И Дата = СохраненноеСостояние.Дата
			И Приоритет = СохраненноеСостояние.Приоритет
			И ЗначениеЗаполнено(СохраненноеСостояние.СрокВыполнения) Тогда
		СрокВыполнения = СохраненноеСостояние.СрокВыполнения;
		Возврат Истина;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Дата) Или Не ЗначениеЗаполнено(Приоритет) Тогда
		СрокВыполнения = Дата(1, 1, 1);
		Возврат Ложь;
	КонецЕсли;
	Часы = НормативныеЧасы(Приоритет);
	Если Часы <= 0 Тогда
		СрокВыполнения = Дата(1, 1, 1);
		Возврат Ложь;
	КонецЕсли;
	СрокВыполнения = Дата + Часы * 3600;
	Возврат Истина;

КонецФункции

Функция НормативныеЧасы(ВыбранныйПриоритет)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Нормативы.Часов КАК Часов
		|ИЗ РегистрСведений.НормативныеСроки КАК Нормативы
		|ГДЕ Нормативы.Приоритет = &Приоритет";
	Запрос.УстановитьПараметр("Приоритет", ВыбранныйПриоритет);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Часов > 0 Тогда
		Возврат Выборка.Часов;
	КонецЕсли;
	Если ВыбранныйПриоритет = Перечисления.Приоритеты.Высокий Тогда
		Возврат 4;
	ИначеЕсли ВыбранныйПриоритет = Перечисления.Приоритеты.Обычный Тогда
		Возврат 24;
	ИначеЕсли ВыбранныйПриоритет = Перечисления.Приоритеты.Низкий Тогда
		Возврат 72;
	КонецЕсли;
	Возврат 0;

КонецФункции

Процедура СообщитьОбОшибке(ТекстОшибки, ИмяПоля, Отказ)

	Отказ = Истина;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Поле = ИмяПоля;
	Сообщение.Сообщить();

КонецПроцедуры

Функция ТолькоПробелы(Текст)

	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Текст = СтрЗаменить(Текст, Символ(160), " ");
	Возврат ПустаяСтрока(СокрЛП(Текст));

КонецФункции
