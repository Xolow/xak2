// Загрузка книги XLSX. Файл передается с клиента через временное хранилище.
Функция Загрузить(АдресФайла) Экспорт
	Папка = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(Папка);
	ИмяАрхива = ПолучитьИмяВременногоФайла("xlsx");
	Попытка
		Данные = ПолучитьИзВременногоХранилища(АдресФайла);
		Если Данные = Неопределено Тогда
			ВызватьИсключение "Файл не передан на сервер";
		КонецЕсли;
		Данные.Записать(ИмяАрхива);
		Архив = Новый ЧтениеZipФайла(ИмяАрхива);
		РазрешенныеФайлы = СтрРазделить("xl/sharedStrings.xml,xl/worksheets/sheet1.xml,xl/worksheets/sheet2.xml,xl/worksheets/sheet3.xml,xl/worksheets/sheet4.xml,xl/worksheets/sheet5.xml,xl/worksheets/sheet6.xml", ",");
		Найденные = Новый Соответствие;
		ОбщийРазмер = 0;
		Для Каждого Элемент Из Архив.Элементы Цикл
			Имя = СтрЗаменить(Элемент.ПолноеИмя, "\", "/");
			Если РазрешенныеФайлы.Найти(Имя) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Найденные.Получить(Имя) <> Неопределено Тогда
				ВызватьИсключение "Повторяющийся файл в книге: " + Имя;
			КонецЕсли;
			Найденные.Вставить(Имя, Истина);
			ОбщийРазмер = ОбщийРазмер + Элемент.РазмерНесжатого;
			Если ОбщийРазмер > 10485760 Тогда
				ВызватьИсключение "Размер содержимого книги превышает 10 МБ";
			КонецЕсли;
			Архив.Извлечь(Элемент, Папка, РежимВосстановленияПутейФайловZIP.Восстанавливать);
		КонецЦикла;
		Архив.Закрыть();
		Результат = ЗагрузитьИзПапки(Папка);
	Исключение
		Результат = "Ошибка загрузки: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Попытка
		УдалитьФайлы(ИмяАрхива);
	Исключение
	КонецПопытки;
	Попытка
		УдалитьФайлы(Папка);
	Исключение
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция ЗагрузитьИзПапки(Папка)
	Разделитель = "/";
	Путь = Папка + Разделитель + "xl/";
	Строки = ПрочитатьОбщиеСтроки(Путь + "sharedStrings.xml");
	Листы = Новый Массив;
	Заголовки = Новый Массив;
	Заголовки.Добавить("id_корпуса|краткое_название|полное_название|адрес");
	Заголовки.Добавить("id_помещения|id_корпуса|корпус|номер|этаж|тип|примечание");
	Заголовки.Добавить("id_исполнителя|ФИО|специализация|контакт");
	Заголовки.Добавить("id_категории|название|описание|типовой_исполнитель");
	Заголовки.Добавить("приоритет|норматив_в_часах|описание");
	Заголовки.Добавить("id_заявки|дата_регистрации|id_помещения|помещение|корпус|описание|id_категории|категория|приоритет|id_исполнителя|исполнитель|статус|дата_выполнения|описание_результата");
	Для Номер = 1 По 6 Цикл
		Таблица = ПрочитатьЛист(Путь + "worksheets/sheet" + Формат(Номер, "ЧГ=0") + ".xml", Строки);
		Если Таблица.Количество() = 0 Тогда
			ВызватьИсключение "Пустой лист " + Номер;
		КонецЕсли;
		ОжидаемыеПоля = СтрРазделить(Заголовки[Номер - 1], "|");
		Для Колонка = 1 По ОжидаемыеПоля.Количество() Цикл
			Если Ячейка(Таблица[0], Колонка) <> ОжидаемыеПоля[Колонка - 1] Тогда
				ВызватьИсключение "Неверный заголовок: лист " + Номер + ", колонка " + Колонка;
			КонецЕсли;
		КонецЦикла;
		Листы.Добавить(Таблица);
	КонецЦикла;
	НачатьТранзакцию();
	Попытка
		ЗагрузитьКорпуса(Листы[0]);
		ЗагрузитьПомещения(Листы[1]);
		ЗагрузитьИсполнителей(Листы[2]);
		ЗагрузитьКатегории(Листы[3]);
		ЗагрузитьНормативы(Листы[4]);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Возврат ЗагрузитьОбращения(Листы[5]);
КонецФункции

Функция ПрочитатьОбщиеСтроки(ИмяФайла)
	Результат = Новый Массив;
	ФайлСтрок = Новый Файл(ИмяФайла);
	Если Не ФайлСтрок.Существует() Тогда
		Возврат Результат;
	КонецЕсли;
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	Текст = "";
	ВСтроке = Ложь;
	ВТексте = Ложь;
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.ЛокальноеИмя = "si" Тогда
				Текст = "";
				ВСтроке = Истина;
			ИначеЕсли Чтение.ЛокальноеИмя = "t" И ВСтроке Тогда
				ВТексте = Истина;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст И ВТексте Тогда
			Текст = Текст + Чтение.Значение;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если Чтение.ЛокальноеИмя = "t" Тогда
				ВТексте = Ложь;
			ИначеЕсли Чтение.ЛокальноеИмя = "si" Тогда
				Результат.Добавить(Текст);
				ВСтроке = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция ПрочитатьЛист(ИмяФайла, ОбщиеСтроки)
	Результат = Новый Массив;
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	СтрокаЛиста = Неопределено;
	НомерКолонки = 0;
	ТипЯчейки = "";
	Значение = "";
	ВЗначении = Ложь;
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.ЛокальноеИмя = "row" Тогда
				СтрокаЛиста = Новый Соответствие;
			ИначеЕсли Чтение.ЛокальноеИмя = "c" Тогда
				Адрес = Чтение.ПолучитьАтрибут("r");
				ТипЯчейки = Чтение.ПолучитьАтрибут("t");
				НомерКолонки = 0;
				Для Индекс = 1 По СтрДлина(Адрес) Цикл
					Буква = Сред(Адрес, Индекс, 1);
					Позиция = СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZ", Буква);
					Если Позиция = 0 Тогда
						Прервать;
					КонецЕсли;
					НомерКолонки = НомерКолонки * 26 + Позиция;
				КонецЦикла;
				Значение = "";
			ИначеЕсли Чтение.ЛокальноеИмя = "v" Или Чтение.ЛокальноеИмя = "t" Тогда
				ВЗначении = Истина;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст И ВЗначении Тогда
			Значение = Значение + Чтение.Значение;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если Чтение.ЛокальноеИмя = "v" Или Чтение.ЛокальноеИмя = "t" Тогда
				ВЗначении = Ложь;
			ИначеЕсли Чтение.ЛокальноеИмя = "c" Тогда
				Если ТипЯчейки = "s" Тогда
					Значение = ОбщиеСтроки[Число(Значение)];
				КонецЕсли;
				СтрокаЛиста.Вставить(НомерКолонки, Значение);
			ИначеЕсли Чтение.ЛокальноеИмя = "row" Тогда
				Результат.Добавить(СтрокаЛиста);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция Ячейка(СтрокаЛиста, Колонка)
	Значение = СтрокаЛиста.Получить(Колонка);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значение);
КонецФункции

Процедура ЗагрузитьКорпуса(Таблица)
	Для Индекс = 1 По Таблица.Количество() - 1 Цикл
		СтрокаДанных = Таблица[Индекс];
		Код = Ячейка(СтрокаДанных, 1);
		Если ПустаяСтрока(Код) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Справочники.Корпуса.НайтиПоКоду(Код)) Тогда
			Продолжить;
		КонецЕсли;
		Объект = Справочники.Корпуса.СоздатьЭлемент();
		Объект.Код = Код;
		Объект.Наименование = Ячейка(СтрокаДанных, 2);
		Объект.ПолноеНаименование = Ячейка(СтрокаДанных, 3);
		Объект.Адрес = Ячейка(СтрокаДанных, 4);
		Объект.Записать();
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьПомещения(Таблица)
	Для Индекс = 1 По Таблица.Количество() - 1 Цикл
		СтрокаДанных = Таблица[Индекс];
		Код = Ячейка(СтрокаДанных, 1);
		Если ПустаяСтрока(Код) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Справочники.Помещения.НайтиПоКоду(Код)) Тогда
			Продолжить;
		КонецЕсли;
		Корпус = Справочники.Корпуса.НайтиПоКоду(Ячейка(СтрокаДанных, 2));
		Если Не ЗначениеЗаполнено(Корпус) Тогда
			ВызватьИсключение "Помещение " + Код + ": неизвестный корпус";
		КонецЕсли;
		Объект = Справочники.Помещения.СоздатьЭлемент();
		Объект.Код = Код;
		Объект.Корпус = Корпус;
		Объект.Номер = Ячейка(СтрокаДанных, 4);
		Объект.Наименование = Ячейка(СтрокаДанных, 3) + ", " + Объект.Номер;
		Объект.Этаж = Число(Ячейка(СтрокаДанных, 5));
		Объект.ВидПомещения = Ячейка(СтрокаДанных, 6);
		Объект.Примечание = Ячейка(СтрокаДанных, 7);
		Объект.Записать();
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьИсполнителей(Таблица)
	Для Индекс = 1 По Таблица.Количество() - 1 Цикл
		СтрокаДанных = Таблица[Индекс];
		Код = Ячейка(СтрокаДанных, 1);
		Если ПустаяСтрока(Код) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Справочники.Исполнители.НайтиПоКоду(Код)) Тогда
			Продолжить;
		КонецЕсли;
		Объект = Справочники.Исполнители.СоздатьЭлемент();
		Объект.Код = Код;
		Объект.Наименование = Ячейка(СтрокаДанных, 2);
		Объект.Специализация = Ячейка(СтрокаДанных, 3);
		Объект.Контакт = Ячейка(СтрокаДанных, 4);
		Объект.Записать();
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьКатегории(Таблица)
	Для Индекс = 1 По Таблица.Количество() - 1 Цикл
		СтрокаДанных = Таблица[Индекс];
		Код = Ячейка(СтрокаДанных, 1);
		Если ПустаяСтрока(Код) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Справочники.КатегорииНеисправностей.НайтиПоКоду(Код)) Тогда
			Продолжить;
		КонецЕсли;
		Объект = Справочники.КатегорииНеисправностей.СоздатьЭлемент();
		Объект.Код = Код;
		Объект.Наименование = Ячейка(СтрокаДанных, 2);
		Объект.Описание = Ячейка(СтрокаДанных, 3);
		Объект.ТиповойИсполнитель = Справочники.Исполнители.НайтиПоНаименованию(Ячейка(СтрокаДанных, 4), Истина);
		Если Не ЗначениеЗаполнено(Объект.ТиповойИсполнитель) Тогда
			ВызватьИсключение "Категория " + Код + ": неизвестный исполнитель";
		КонецЕсли;
		Объект.Записать();
	КонецЦикла;
КонецПроцедуры

Функция ПриоритетПоИмени(Имя)
	Если Имя = "Высокий" Тогда
		Возврат Перечисления.Приоритеты.Высокий;
	ИначеЕсли Имя = "Обычный" Тогда
		Возврат Перечисления.Приоритеты.Обычный;
	ИначеЕсли Имя = "Низкий" Тогда
		Возврат Перечисления.Приоритеты.Низкий;
	КонецЕсли;
	Возврат Перечисления.Приоритеты.ПустаяСсылка();
КонецФункции

Функция СтатусПоИмени(Имя)
	Если Имя = "Новая" Тогда
		Возврат Перечисления.СтатусыОбращений.Новая;
	ИначеЕсли Имя = "В работе" Тогда
		Возврат Перечисления.СтатусыОбращений.ВРаботе;
	ИначеЕсли Имя = "Выполнена" Тогда
		Возврат Перечисления.СтатусыОбращений.Выполнена;
	ИначеЕсли Имя = "Отменена" Тогда
		Возврат Перечисления.СтатусыОбращений.Отменена;
	КонецЕсли;
	Возврат Перечисления.СтатусыОбращений.ПустаяСсылка();
КонецФункции

Процедура ЗагрузитьНормативы(Таблица)
	Для Индекс = 1 По Таблица.Количество() - 1 Цикл
		СтрокаДанных = Таблица[Индекс];
		Если ПустаяСтрока(Ячейка(СтрокаДанных, 1)) Тогда
			Продолжить;
		КонецЕсли;
		Приоритет = ПриоритетПоИмени(Ячейка(СтрокаДанных, 1));
		Если Не ЗначениеЗаполнено(Приоритет) Тогда
			ВызватьИсключение "Неизвестный приоритет норматива: " + Ячейка(СтрокаДанных, 1);
		КонецЕсли;
		Набор = РегистрыСведений.НормативныеСроки.СоздатьНаборЗаписей();
		Набор.Отбор.Приоритет.Установить(Приоритет);
		Набор.Прочитать();
		Если Набор.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Запись = Набор.Добавить();
		Запись.Приоритет = Приоритет;
		Запись.Часов = Число(Ячейка(СтрокаДанных, 2));
		Запись.Описание = Ячейка(СтрокаДанных, 3);
		Набор.Записать();
	КонецЦикла;
КонецПроцедуры

Функция ДатаExcel(Значение)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	ЧислоДней = Число(СтрЗаменить(Значение, ".", ","));
	Если ЧислоДней < 61 Тогда
		ВызватьИсключение "Некорректная дата Excel";
	КонецЕсли;
	Возврат Дата(1899, 12, 30) + Окр(ЧислоДней * 86400, 0);
КонецФункции

Функция ЗагрузитьОбращения(Таблица)
	Создано = 0;
	Пропущено = 0;
	Ошибок = 0;
	Диагностика = "";
	Для Индекс = 1 По Таблица.Количество() - 1 Цикл
		СтрокаДанных = Таблица[Индекс];
		Код = Ячейка(СтрокаДанных, 1);
		Если ПустаяСтрока(Код) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Обращение ГДЕ КодИсточника = &Код");
			Запрос.УстановитьПараметр("Код", Код);
			Если Не Запрос.Выполнить().Пустой() Тогда
				Пропущено = Пропущено + 1;
				Продолжить;
			КонецЕсли;
			Помещение = Справочники.Помещения.НайтиПоКоду(Ячейка(СтрокаДанных, 3));
			Категория = Справочники.КатегорииНеисправностей.НайтиПоКоду(Ячейка(СтрокаДанных, 7));
			Приоритет = ПриоритетПоИмени(Ячейка(СтрокаДанных, 9));
			Статус = СтатусПоИмени(Ячейка(СтрокаДанных, 12));
			Исполнитель = Справочники.Исполнители.НайтиПоКоду(Ячейка(СтрокаДанных, 10));
			Причины = "";
			Если Не ЗначениеЗаполнено(Помещение) Тогда
				Причины = Причины + "не указано или не найдено помещение; ";
			КонецЕсли;
			Если ПустаяСтрока(Ячейка(СтрокаДанных, 6)) Тогда
				Причины = Причины + "не указано описание; ";
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Категория) Тогда
				Причины = Причины + "не указана или не найдена категория; ";
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Приоритет) Тогда
				Причины = Причины + "не указан или неизвестен приоритет; ";
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Статус) Тогда
				Причины = Причины + "не указан или неизвестен статус; ";
			КонецЕсли;
			Если Не ПустаяСтрока(Ячейка(СтрокаДанных, 10)) И Не ЗначениеЗаполнено(Исполнитель) Тогда
				Причины = Причины + "исполнитель не найден; ";
			КонецЕсли;
			Если (Статус = Перечисления.СтатусыОбращений.ВРаботе Или Статус = Перечисления.СтатусыОбращений.Выполнена) И Не ЗначениеЗаполнено(Исполнитель) Тогда
				Причины = Причины + "не указан исполнитель; ";
			КонецЕсли;
			Если Статус = Перечисления.СтатусыОбращений.Выполнена И ПустаяСтрока(Ячейка(СтрокаДанных, 14)) Тогда
				Причины = Причины + "не указан результат выполнения; ";
			КонецЕсли;
			ДатаРегистрации = ДатаExcel(Ячейка(СтрокаДанных, 2));
			ДатаОкончания = ДатаExcel(Ячейка(СтрокаДанных, 13));
			Если Не ЗначениеЗаполнено(ДатаРегистрации) Тогда
				Причины = Причины + "не указана дата регистрации; ";
			КонецЕсли;
			Если Статус = Перечисления.СтатусыОбращений.Выполнена И Не ЗначениеЗаполнено(ДатаОкончания) Тогда
				Причины = Причины + "не указана дата выполнения; ";
			КонецЕсли;
			Если Не ПустаяСтрока(Причины) Тогда
				Ошибок = Ошибок + 1;
				Диагностика = Диагностика + Символы.ПС + Код + ": " + Причины;
				Продолжить;
			КонецЕсли;
			ЗапросНомера = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Обращение ГДЕ Номер = &Номер");
			ЗапросНомера.УстановитьПараметр("Номер", Код);
			Если Не ЗапросНомера.Выполнить().Пустой() Тогда
				ВызватьИсключение "Номер уже занят другим обращением";
			КонецЕсли;
			Объект = Документы.Обращение.СоздатьДокумент();
			Объект.Номер = Код;
			Объект.КодИсточника = Код;
			Объект.Дата = ДатаРегистрации;
			Объект.Помещение = Помещение;
			Объект.Описание = Ячейка(СтрокаДанных, 6);
			Объект.Категория = Категория;
			Объект.Приоритет = Приоритет;
			Объект.Исполнитель = Исполнитель;
			Объект.Статус = Статус;
			Объект.ДатаВыполнения = ДатаОкончания;
			Объект.Результат = Ячейка(СтрокаДанных, 14);
			Объект.ДополнительныеСвойства.Вставить("ЗагрузкаИсходныхДанных", Истина);
			Объект.Записать();
			Создано = Создано + 1;
		Исключение
			Ошибок = Ошибок + 1;
			Диагностика = Диагностика + Символы.ПС + Код + ": " + ИнформацияОбОшибке().Описание;
		КонецПопытки;
	КонецЦикла;
	Возврат "Создано обращений: " + Создано + "; уже существовали: " + Пропущено + "; отклонено: " + Ошибок + "." + Диагностика;
КонецФункции
