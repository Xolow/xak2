// Состояние на конец секунды. Запись выполняется в транзакции документа.
Процедура ЗафиксироватьИзменение(Обращение, ПредыдущееСостояние) Экспорт

	Если ПредыдущееСостояние = Неопределено Тогда
		ЗаписатьНачальнуюИсторию(Обращение);
		Возврат;
	КонецЕсли;

	Если Не ИзменилисьДанныеОтчета(Обращение, ПредыдущееСостояние) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЕстьИстория(Обращение.Ссылка) Тогда
		ЗаписатьНачальнуюИсторию(ПредыдущееСостояние);
	КонецЕсли;

	ЗаписатьСнимок(Обращение, ТекущаяДатаСеанса(), Обращение.Статус);

КонецПроцедуры

Функция ИзменилисьДанныеОтчета(Обращение, ПредыдущееСостояние)

	Реквизиты = СтрРазделить("Дата,Номер,Помещение,Описание,Категория,Исполнитель,Приоритет,Статус,СрокВыполнения,ПометкаУдаления", ",");
	Для Каждого ИмяРеквизита Из Реквизиты Цикл
		Если Обращение[ИмяРеквизита] <> ПредыдущееСостояние[ИмяРеквизита] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЕстьИстория(Ссылка)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	История.Период
		|ИЗ РегистрСведений.ИсторияОбращений КАК История
		|ГДЕ История.Обращение = &Обращение");
	Запрос.УстановитьПараметр("Обращение", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Процедура ЗаписатьНачальнуюИсторию(Обращение)

	Если Не ЗначениеЗаполнено(Обращение.Дата) Тогда
		Возврат;
	КонецЕсли;

	// Для завершённых исходных обращений известна дата окончания.
	// Для отменённых без даты отмены сохраняем только известное состояние.
	Начало = Мин(Обращение.Дата, ТекущаяДатаСеанса());
	Если Обращение.Статус = Перечисления.СтатусыОбращений.Выполнена
			И Обращение.ДатаВыполнения > Обращение.Дата Тогда
		ЗаписатьСнимок(Обращение, Начало, Перечисления.СтатусыОбращений.ВРаботе);
		ЗаписатьСнимок(Обращение, Обращение.ДатаВыполнения, Обращение.Статус);
	Иначе
		ЗаписатьСнимок(Обращение, Начало, Обращение.Статус);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьСнимок(Обращение, Момент, СтатусСнимка)

	Запись = РегистрыСведений.ИсторияОбращений.СоздатьМенеджерЗаписи();
	Запись.Период = Момент;
	Запись.Обращение = Обращение.Ссылка;
	Запись.ДатаРегистрации = Обращение.Дата;
	Запись.Номер = Обращение.Номер;
	Запись.Помещение = Обращение.Помещение;
	Запись.Описание = Обращение.Описание;
	Запись.Категория = Обращение.Категория;
	Запись.Исполнитель = Обращение.Исполнитель;
	Запись.Приоритет = Обращение.Приоритет;
	Запись.Статус = СтатусСнимка;
	Запись.СрокВыполнения = Обращение.СрокВыполнения;
	Запись.ПометкаУдаления = Обращение.ПометкаУдаления;
	Запись.Записать(Истина);

КонецПроцедуры
